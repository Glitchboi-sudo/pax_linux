+    case A_HDSK: /* PAX proprietary handshake (recovered from pax_adb.exe) */
+        D("PID(%d) A_HDSK\n", getpid());
+        if (p->msg.arg0 == PAX_HANDSHAKE_REQ) {
+            /* The PAX terminal's adbd asks the host to identify itself before
+             * it will bring the connection online.  The expected answer is a
+             * fixed magic string ("paxadb") sent back as A_HDSK/arg0=2.
+             * There is no cryptography involved. */
+            D("PID(%d) A_HDSK PAX_HANDSHAKE_REQ\n", getpid());
+            if (HOST) {
+                apacket *np = get_apacket();
+                size_t len = strlen(PAX_HANDSHAKE_MAGIC);
+                memcpy(np->data, PAX_HANDSHAKE_MAGIC, len);
+                np->msg.command = A_HDSK;
+                np->msg.arg0 = PAX_HANDSHAKE_RES;
+                np->msg.arg1 = 0;
+                np->msg.data_length = len;
+                D("Calling send_handshake_response\n");
+                send_packet(np, t);
+            }
+        } else if (p->msg.arg0 == PAX_HANDSHAKE_RES) {
+            D("PID(%d) A_HDSK PAX_HANDSHAKE_RES\n", getpid());
+        } else {
+            D("PID(%d) A_HDSK UNKNOWN\n", getpid());
+        }
+        break;
+
     default:
         printf("handle_packet: what is %08x?!\n", p->msg.command);
     }
