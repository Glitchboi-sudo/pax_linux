+#define A_HDSK 0x4b534448           // PAX proprietary handshake ('HDSK')
+
+/* PAX handshake sub-commands, carried in amessage.arg0 */
+#define PAX_HANDSHAKE_REQ 1         // device -> host: requests the handshake
+#define PAX_HANDSHAKE_RES 2         // host -> device: handshake response
+#define PAX_HANDSHAKE_MAGIC "paxadb"
 
 #define A_VERSION 0x01000000        // ADB protocol version
 
