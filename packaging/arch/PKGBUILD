# Maintainer: Glitchboi-sudo
#
# Build from a checkout of this repository:
#   cd packaging/arch && makepkg -f
#   sudo pacman -U pax-adb-*.pkg.tar.zst
pkgname=pax-adb
pkgver=1.0.32
pkgrel=2
pkgdesc="Native Linux build of AOSP adb with PAX patches (A_HDSK handshake + syslog/systool/unlink/getappinfo commands) for PAX PayDroid POS terminals"
arch=('x86_64')
url="https://github.com/Glitchboi-sudo/pax_linux"
license=('Apache')
depends=('openssl' 'zlib')
makedepends=('gcc' 'make')
optdepends=('android-tools: standard fastboot for flashing the PAX bootloader (paydroidboot equivalent)')
install=pax-adb.install

# repository root, relative to this PKGBUILD (packaging/arch/)
_repo() { realpath "$startdir/../.."; }

build() {
  local repo; repo="$(_repo)"
  rm -rf "$srcdir/tree"
  mkdir -p "$srcdir/tree"
  cp -rT "$repo/src" "$srcdir/tree/src"
  cp -rT "$repo/include" "$srcdir/tree/include"
  cp "$repo/Makefile" "$srcdir/tree/Makefile"
  # copy only the udev rule needed by package(); copying all of packaging/ would
  # recurse into makepkg's srcdir which lives under packaging/arch/.
  install -Dm644 "$repo/packaging/udev/51-android-pax.rules" \
    "$srcdir/tree/packaging/udev/51-android-pax.rules"
  cp "$repo/NOTICE" "$srcdir/tree/NOTICE" 2>/dev/null || true
  make -C "$srcdir/tree"
}

package() {
  cd "$srcdir/tree"
  install -Dm755 pax_adb "$pkgdir/usr/bin/pax_adb"
  install -Dm644 packaging/udev/51-android-pax.rules \
    "$pkgdir/usr/lib/udev/rules.d/51-android-pax.rules"
  install -Dm644 NOTICE "$pkgdir/usr/share/licenses/$pkgname/NOTICE" 2>/dev/null || true
}
