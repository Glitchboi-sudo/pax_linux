# PAX adb patch — changes on top of AOSP system/core adb (android-5.1.1_r38)
# Functional PAX additions:
#   adb.h/adb.c        A_HDSK 'paxadb' handshake
#   usb_vendors.c      PAX USB vendor IDs 0x2FB8 / 0x0327
#   commandline.c      syslog, systool, unlink, getappinfo commands (+ persist-app routing)
#   file_sync_*.c/.h   do_sync_unlink / sync_unlink (ULNK sync request)
# Portability fixes for modern glibc / OpenSSL 3.x:
#   usb_linux.c        include <sys/sysmacros.h>
#   adb_auth_host.c    RSA_get0_key accessor

