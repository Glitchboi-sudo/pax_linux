# PAX adb patch — changes applied on top of AOSP system/core adb (android-5.1.1_r38)
# Two functional PAX changes (adb.h, adb.c, usb_vendors.c) + two portability fixes
# (usb_linux.c, adb_auth_host.c) needed to build against modern glibc/OpenSSL 3.x.

--- a/adb/adb.h	2026-09-11 21:06:53.081936755 -0600
+++ b/adb/adb.h	2026-09-11 21:13:57.028743653 -0600
@@ -31,6 +31,12 @@
 #define A_CLSE 0x45534c43
 #define A_WRTE 0x45545257
 #define A_AUTH 0x48545541
+#define A_HDSK 0x4b534448           // PAX proprietary handshake ('HDSK')
+
+/* PAX handshake sub-commands, carried in amessage.arg0 */
+#define PAX_HANDSHAKE_REQ 1         // device -> host: requests the handshake
+#define PAX_HANDSHAKE_RES 2         // host -> device: handshake response
+#define PAX_HANDSHAKE_MAGIC "paxadb"
 
 #define A_VERSION 0x01000000        // ADB protocol version
 
--- a/adb/adb.c	2026-09-11 21:06:53.081936755 -0600
+++ b/adb/adb.c	2026-09-11 21:14:06.228996734 -0600
@@ -657,6 +657,32 @@
         }
         break;
 
+    case A_HDSK: /* PAX proprietary handshake (recovered from pax_adb.exe) */
+        D("PID(%d) A_HDSK\n", getpid());
+        if (p->msg.arg0 == PAX_HANDSHAKE_REQ) {
+            /* The PAX terminal's adbd asks the host to identify itself before
+             * it will bring the connection online.  The expected answer is a
+             * fixed magic string ("paxadb") sent back as A_HDSK/arg0=2.
+             * There is no cryptography involved. */
+            D("PID(%d) A_HDSK PAX_HANDSHAKE_REQ\n", getpid());
+            if (HOST) {
+                apacket *np = get_apacket();
+                size_t len = strlen(PAX_HANDSHAKE_MAGIC);
+                memcpy(np->data, PAX_HANDSHAKE_MAGIC, len);
+                np->msg.command = A_HDSK;
+                np->msg.arg0 = PAX_HANDSHAKE_RES;
+                np->msg.arg1 = 0;
+                np->msg.data_length = len;
+                D("Calling send_handshake_response\n");
+                send_packet(np, t);
+            }
+        } else if (p->msg.arg0 == PAX_HANDSHAKE_RES) {
+            D("PID(%d) A_HDSK PAX_HANDSHAKE_RES\n", getpid());
+        } else {
+            D("PID(%d) A_HDSK UNKNOWN\n", getpid());
+        }
+        break;
+
     default:
         printf("handle_packet: what is %08x?!\n", p->msg.command);
     }
